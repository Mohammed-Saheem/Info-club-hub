# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/info_club_hub
DB_HOST=localhost
DB_PORT=5432
DB_NAME=info_club_hub
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Supabase Admin (for user management via service_role key)
# IMPORTANT: Never expose SUPABASE_SERVICE_ROLE_KEY to the client/browser!
# Get these values from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
